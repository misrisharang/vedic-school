# Supabase Configuration for The Vedic School
# Replace with your actual project URL and Publishable (anon) Key from the Supabase dashboard
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Canonical Site URL (defaults to https://the-vedic-school.netlify.app if unset)
VITE_SITE_URL=https://the-vedic-school.netlify.app

